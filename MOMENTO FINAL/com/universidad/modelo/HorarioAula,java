package com.universidad.modelo;

public class HorarioAula {

    // HORARIO DEl Salon 5 days x 6 bloques
    private String[][] horario;

    
    public HorarioAula() {

        horario = new String[5][6];
    }

    // ASIgnador de Materia a HOriao 
    public void asignar(
            int dia,
            int bloque,
            String materia) {

        horario[dia][bloque] = materia;
    }

    // Visual x Horio de sAlon 
    public void mostrarHorario() {

        for (int i = 0; i < horario.length; i++) {

            for (int j = 0;
                 j < horario[i].length;
                 j++) {

                System.out.print(
                        horario[i][j] + "\t");
            }

            System.out.println();
        }
    }
}